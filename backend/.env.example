# Template for backend/.env: copy this file to backend/.env and fill in real values.
# Sample values only; never commit real credentials.
# DATABASE_URL here is the team's shared database. To work on a separate local database instead, create
# backend/.env.local (gitignored) with its own DATABASE_URL: with that file, development never uses the one below.

# Supabase PostgreSQL connection (Project Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional: a SEPARATE test database (e.g. a staging Supabase project) for tests/test_postgres_integration.py.
# Those tests TRUNCATE every table of this database and refuse to run when it equals DATABASE_URL.
TEST_DATABASE_URL=

# Development: one backend worker; memory state is cleared on process restart.
APP_ENV=development
AUTH_STATE_BACKEND=memory
# The local project key is generated during setup; use a separate random key in production.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_JWT_ISSUER=vietech
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AUTH_ACCESS_TTL=900
AUTH_CUSTOMER_SESSION_TTL=604800
AUTH_INTERNAL_SESSION_TTL=28800
AUTH_INTERNAL_IDLE_TTL=1800
AUTH_SIGNUP_OTP_TTL=90
AUTH_RESET_OTP_TTL=60
AUTH_RESET_GRANT_TTL=300
AUTH_EMAIL_OTP_TTL=90
AUTH_FAILURE_LIMIT=5
AUTH_BLOCK_TTL=180
AUTH_FAILURE_WINDOW=900
AUTH_RESEND_INTERVAL=60
# At most AUTH_SEND_LIMIT OTP emails per purpose and recipient within AUTH_SEND_WINDOW seconds.
AUTH_SEND_LIMIT=5
AUTH_SEND_WINDOW=3600

# External SMTP provider: STARTTLS usually 587; SSL usually 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10

# DATABASE_URL connects to PostgreSQL tables. Avatar files use the separate Storage HTTP API.
# Avatar uploads: server-only secret key (preferred) or legacy service_role key.
# Keep both keys out of frontend code and Git. Configure one key, then run:
# python -m app.cli.setup_avatar_storage
# The command checks/creates a public bucket limited to JPG/PNG/WEBP, up to 2 MiB.
# Without a project URL and server key, uploads return 503.
# Project URL from Supabase Connect / Data API, e.g. https://<project-ref>.supabase.co.
# Use the same project as DATABASE_URL. Keep the existing database and auth settings.
SUPABASE_URL=
# Preferred: sb_secret_... from Supabase Dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=
# Alternative for projects using the legacy service_role JWT.
# Paste the complete API key, not the database password, anon key or publishable key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
# Restart the backend after changing these settings, then check:
# python -m app.cli.setup_avatar_storage --check

# Production requires APP_ENV=production, AUTH_STATE_BACKEND=redis, HTTPS CORS.
# Use rediss:// when your provider requires TLS.
REDIS_URL=

# SePay (bank transaction webhook + VietQR). Leave empty until payments are enabled.
# While any required value below is empty, customers see "Thanh toán chuyển khoản hiện chưa sẵn sàng".
# In the SePay dashboard: register the webhook URL https://<public backend host>/webhooks/sepay (JSON body,
# HMAC-SHA256 signature) and set the payment code structure to the same prefix and length as below.
# Required for the webhook (requests are rejected while missing):
# SEPAY_ACCOUNT_NUMBER: the account customers transfer into (the QR "acc"). Banks that SePay supports only through an
# official virtual account (VA), such as MSB ("No main account, must use VA"): put the VA number here, not the main
# account; SePay then reports the VA in "subAccount".
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
# Optional, VA only: the bank account that owns the VA (SePay "accountNumber"); when set, VA transactions must match it.
SEPAY_MAIN_ACCOUNT_NUMBER=
# Required to create QR payments (must match the SePay configuration):
# SEPAY_BANK: bank short name accepted by the QR image service (e.g. Vietcombank, MBBank).
# SEPAY_QR_IMAGE_URL: https QR image endpoint only, without "?..." (e.g. https://qr.sepay.vn/img).
# SEPAY_PAYMENT_CODE_PREFIX: letters/digits, at most 20; SEPAY_PAYMENT_CODE_LENGTH: 8-30 random characters.
SEPAY_BANK=
SEPAY_QR_IMAGE_URL=
SEPAY_PAYMENT_CODE_PREFIX=
SEPAY_PAYMENT_CODE_LENGTH=
# Optional: account holder name shown next to the QR so customers can check the recipient before paying.
SEPAY_ACCOUNT_NAME=

# Return/exchange window in days, counted from the delivery date (default 7 when empty).
RETURN_WINDOW_DAYS=

# Shared secret for the cron endpoints under /internal (at least 32 random bytes). Empty disables them (503).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_CRON_SECRET=

# Gemini Interactions API; history is managed locally and store=false is always sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=120
AI_INPUT_MAX_CHARS=1000
AI_CONTEXT_MAX_TURNS=12
AI_MAX_OUTPUT_TOKENS=2048
# Optional benchmark pacing: use the TPM shown for your project in Google AI Studio. 0 = no estimate.
AI_BENCHMARK_TOKENS_PER_MINUTE=0
AI_REQUESTS_PER_MINUTE=10
AI_MAX_ATTEMPTS=3
AI_MAX_TOOL_ROUNDS=4
AI_MAX_PRODUCTS=5
# Bước 10.6: false = thứ tự catalog gốc (baseline) để so sánh có/không xếp hạng.
AI_RANKING_ENABLED=true
