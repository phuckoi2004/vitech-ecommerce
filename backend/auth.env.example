# Template for backend/.env: copy this file to backend/.env and fill in real values.
# Sample values only; never commit real credentials.

# Supabase PostgreSQL connection (Project Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional: a SEPARATE test database (e.g. a staging Supabase project) for tests/test_postgres_integration.py.
# Those tests TRUNCATE every table of this database and refuse to run when it equals DATABASE_URL.
TEST_DATABASE_URL=

# Development: one backend worker; memory state is cleared on process restart.
APP_ENV=development
AUTH_STATE_BACKEND=memory
# The local project key is generated during setup; use a separate random key in production.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_JWT_ISSUER=vietech
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AUTH_ACCESS_TTL=900
AUTH_CUSTOMER_SESSION_TTL=604800
AUTH_INTERNAL_SESSION_TTL=28800
AUTH_INTERNAL_IDLE_TTL=1800
AUTH_SIGNUP_OTP_TTL=90
AUTH_RESET_OTP_TTL=60
AUTH_RESET_GRANT_TTL=300
AUTH_EMAIL_OTP_TTL=90
AUTH_FAILURE_LIMIT=5
AUTH_BLOCK_TTL=180
AUTH_FAILURE_WINDOW=900
AUTH_RESEND_INTERVAL=60
# At most AUTH_SEND_LIMIT OTP emails per purpose and recipient within AUTH_SEND_WINDOW seconds.
AUTH_SEND_LIMIT=5
AUTH_SEND_WINDOW=3600

# External SMTP provider: STARTTLS usually 587; SSL usually 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10

# DATABASE_URL connects to PostgreSQL tables. Avatar files use the separate Storage HTTP API.
# Avatar uploads: server-only secret key (preferred) or legacy service_role key.
# Keep both keys out of frontend code and Git. Configure one key, then run:
# python -m app.cli.setup_avatar_storage
# The command checks/creates a public bucket limited to JPG/PNG/WEBP, up to 2 MiB.
# Without a project URL and server key, uploads return 503.
# Project URL from Supabase Connect / Data API, e.g. https://<project-ref>.supabase.co.
# Use the same project as DATABASE_URL. Keep the existing database and auth settings.
SUPABASE_URL=
# Preferred: sb_secret_... from Supabase Dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=
# Alternative for projects using the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# Production requires APP_ENV=production, AUTH_STATE_BACKEND=redis, HTTPS CORS.
# Use rediss:// when your provider requires TLS.
REDIS_URL=

# SePay (bank transaction webhook + VietQR). Leave empty until payments are enabled.
# Required for the webhook (requests are rejected while missing):
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
# Required to create QR payments (must match the SePay configuration):
SEPAY_BANK=
SEPAY_QR_IMAGE_URL=
SEPAY_PAYMENT_CODE_PREFIX=
SEPAY_PAYMENT_CODE_LENGTH=

# Return/exchange window in days, counted from the delivery date (default 7 when empty).
RETURN_WINDOW_DAYS=

# Shared secret for the cron endpoints under /internal (at least 32 random bytes). Empty disables them (503).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_CRON_SECRET=
